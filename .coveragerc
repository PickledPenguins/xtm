# Coverage configuration for xtm.
#
# Two settings here are not optional, they are what make the number mean
# anything:
#
#   branch    xtm is mostly branching logic over the output of external
#             tools, so line coverage alone overstates how much is really
#             exercised. Branch coverage is the honest figure.
#
#   parallel  the integration tests run xtm.py as a SUBPROCESS, and each
#             subprocess writes its own data file for `coverage combine` to
#             merge. Without this they overwrite one another.
#
# Parallel mode alone is still not enough: every subprocess must also call
# coverage.process_startup(), which happens only when COVERAGE_PROCESS_START
# is set and a .pth file is on the path. `make coverage` does both. Measured
# without that step, the reported figure collapses from ~95% to ~63%, because
# almost the whole command layer runs in a child process. A bare
# `coverage run -m unittest test_xtm` therefore UNDERSTATES coverage badly --
# if you see 63%, you skipped the recipe, you did not find a regression.
#
# Requires coverage.py 7.2 or newer for `exclude_also`.

[run]
branch = True
parallel = True
source = xtm
# Every generated file lands under .build/, which is the one gitignored
# directory in this tree. Without this the parallel data files -- one per
# subprocess, hundreds of them -- land in the project root.
data_file = .build/coverage/.coverage

[paths]
# The parent process imports xtm as a module while the children execute
# xtm.py by path. Both must fold onto one file, or the report lists them
# separately and every percentage is wrong.
source =
    xtm.py
    */xtm.py

[html]
directory = .build/htmlcov

[report]
precision = 1
show_missing = True
skip_covered = False

# The floor exists so a regression fails CI rather than being noticed later.
# Raise it as coverage improves; never lower it to make a build pass.
#
# Mind which number this is. fail_under compares against coverage.py's
# COMBINED figure -- statements and branch exits over one denominator. The
# three figures currently stand at:
#
#     line coverage      97.8%   (1944 / 1987 statements)
#     branch coverage    95.4%   (878 / 920 branch exits)
#     combined           97.1%   <- what fail_under below compares against
#
# The combined figure is the strictest of the three, so holding the floor
# there keeps the other two above it as well.
#
# The floor moves in steps, each one earned by the tests that raised the
# number rather than to match a figure that drifted upward on its own. What
# remains uncovered is defensive error handling that cannot be reached
# without breaking the filesystem underneath a running process, plus the
# platform fallbacks for fcntl and PyYAML. Chasing those by asserting on
# internals would make the suite more brittle without making the tool more
# correct.
fail_under = 97

exclude_also =
    # Non-POSIX platforms only; unreachable on the systems xtm targets.
    except ImportError:  # pragma: no cover
