{
  "on_switch": "detach",
  "prefix": "dev-",
  "profile": "dev",
  "sessions": [
    {
      "command": "vim",
      "configured": {
        "height": 1080,
        "width": 1280,
        "x": 0,
        "y": 0
      },
      "cwd": "~/work/service",
      "name": "editor",
      "session": "dev-editor",
      "setup": "tmux new-window -d -t \"$XTM_SESSION\" -n shell",
      "shared": false,
      "title": "xtm:dev-editor"
    },
    {
      "command": null,
      "configured": {
        "height": 1080,
        "width": 640,
        "x": 1280,
        "y": 0
      },
      "cwd": "~/work/service",
      "name": "build",
      "session": "dev-build",
      "setup": "tmux split-window -v -t \"$XTM_SESSION\" 'make watch' && tmux select-layout -t \"$XTM_SESSION\" even-vertical",
      "shared": false,
      "title": "xtm:dev-build"
    },
    {
      "command": null,
      "configured": {
        "height": 1080,
        "width": 960,
        "x": 1920,
        "y": 0
      },
      "cwd": null,
      "name": "ops",
      "session": "dev-ops",
      "setup": "~/.config/xtm/ops-layout.sh",
      "shared": false,
      "title": "xtm:dev-ops"
    }
  ],
  "stray_owners": {},
  "strays": []
}
