# Example xtm configuration.
#
# Copy to ~/.config/xtm/config.yaml and adjust the pixel positions to the
# machine. Both the indented style and the compact {key: value} style shown
# below are accepted, with or without PyYAML installed, and comments may
# appear on their own line or at the end of a line.
#
# Session and profile names may contain letters, digits, '.', '_' and '-'.
# Positions and sizes are in pixels; x and y may be negative for a monitor
# placed left of or above the primary one. Width and height must be positive.
#
# Check this file at any time with:  xtm --validate

profiles:

  # The reserved profile. It always exists, is available on every machine,
  # and is what xtm falls back to when nothing else applies. It cannot be
  # deleted or renamed and must not have a 'match' block, but its contents
  # are ordinary and can be edited freely.
  default:
    stack: {x: 40, y: 40, width: 900, height: 650, offset_x: 40, offset_y: 40}
    sessions: {}

  # A two-monitor desk. The 'match' block binds this profile to a machine:
  # it is only visible and selectable on hosts whose short name starts with
  # "workstation". Remove the block (or run 'xtm --make-global desk') to make
  # it available everywhere. 'hostname' also accepts a list, for example
  #   hostname: [workstation, workstation-spare]
  # so one profile can serve several machines with the same layout.
  desk:
    match:
      hostname: workstation*

    # Session names for this profile's slots: slot "work1" below becomes the
    # tmux session "desk-work1". The prefix is what makes a profile own its
    # sessions, so two profiles using the same slot names never collide.
    prefix: desk-

    # What happens to this profile's windows when switching to another
    # profile: leave, detach or kill. "detach" closes the windows but keeps
    # the sessions, their tabs, their panes and their running jobs alive.
    on_switch: detach

    # Window title template for every slot. {slot}, {session} and {profile}
    # are available. Titles are cosmetic; windows are identified by their
    # instance name, which is not configurable.
    title: "{profile}: {slot}"

    # Where sessions with no recorded position are placed. Each additional
    # stacked window is offset diagonally by offset_x / offset_y.
    stack:
      x: 40
      y: 40
      width: 900
      height: 650
      offset_x: 40
      offset_y: 40

    sessions:
      # A plain full-height editor window on the left monitor.
      work1:
        x: 0
        y: 0
        width: 960
        height: 1180

      # A log tail. 'command' runs when the session is CREATED; attaching to
      # an existing session ignores it. The pane closes when the command
      # exits, so wrap it if the shell should outlive it, for example:
      #   command: bash -lc 'journalctl -f; exec bash'
      logs:
        x: 960
        y: 0
        width: 960
        height: 580
        command: journalctl -f

      # A slot with an explicit session name. The name is used verbatim and
      # is NEVER prefixed, so any profile naming the same session shares it.
      # A shared session is also left alone when switching profiles.
      notes:
        session: notes
        x: 0
        y: 1180
        width: 960
        height: 400

      # A session that opens straight onto a remote host, starting in a
      # chosen directory, with a distinct background so it is obvious at a
      # glance which windows are remote. 'xterm_args' is appended verbatim
      # to the xterm command line.
      cluster:
        x: 960
        y: 600
        width: 960
        height: 580
        cwd: ~/projects
        command: ssh headnode
        xterm_args: [-bg, "#2a1a1a", -fa, Monospace, -fs, "11"]

  # A single-screen laptop. The compact style is used here; it is equivalent
  # to the indented style above.
  laptop:
    match: {hostname: thinkpad*}
    stack: {x: 20, y: 20, width: 700, height: 900, offset_x: 30, offset_y: 30}
    sessions:
      work1: {x: 0, y: 0, width: 1000, height: 1400}
      logs:  {x: 1000, y: 0, width: 900, height: 700}

  # A profile with no 'match' block is global: available on every machine,
  # but never selected automatically, since being available everywhere is no
  # evidence that it belongs here. Use it by name: 'xtm presentation'.
  presentation:
    stack: {x: 100, y: 100, width: 1200, height: 800, offset_x: 50, offset_y: 50}
    sessions:
      demo: {x: 0, y: 0, width: 1920, height: 1080, xterm_args: [-fs, "16"]}
